    "type": "git",
    "url": "git+https://github.com/nejroseld/sync-and-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nejroseld/sync-and-mcp/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "e2ee",
    "mcp"
  ],
  "scripts": {
    "typecheck": "tsc -noEmit -skipLibCheck",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs --watch",
    "test": "mocha --import=tsx 'tests/**/*.test.ts'",
    "e2e": "tsx tests-e2e/e2e.ts"
  },
