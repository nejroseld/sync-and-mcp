    "@types/qrcode": "^1.5.6",
    "chai": "^4.4.1",
    "esbuild": "^0.23.0",
    "mocha": "^10.7.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@fyears/rclone-crypt": "^0.0.7",
    "buffer": "^6.0.3",
    "jsqr": "^1.4.0",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "p-queue": "^8.0.1",
    "path-browserify": "^1.0.1",
